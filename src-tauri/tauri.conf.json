{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hopback",
  "version": "0.1.0",
  "identifier": "se.zexa.hopback",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && scripts/build-hook.sh"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Get back to your Claude Code sessions in VS Code",
    "copyright": "Copyright (c) 2026 Aaron Sun. MIT licence.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/hopback-hook"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4NkMyMTQ5OEIxMkNFREUKUldUZXpoS0xTU0ZzbU1IZ2psRW1nMnV4TU9aUTA5c3kybFYzRjE4RjFYUTNFMnplTnJ2ZEc4T2UK",
      "endpoints": ["https://github.com/aaronsuns/hopback/releases/latest/download/latest.json"]
    }
  }
}
